# Copy to .env (git-ignored) to override the compose defaults. No secrets are needed for the local stack.

# Host ports. MLflow listens on 5000 inside the network, but macOS uses host port 5000 for AirPlay,
# so the UI is published on 5001 by default.
MLFLOW_PORT=5001
API_PORT=8000

# Tag for the image built from docker/Dockerfile.
H1B_IMAGE=h1b-salary:dev

# Where `make register-docker` reads train/val parquet from (mounted read-only). Default: ./data/processed
# H1B_PROCESSED_DIR=/absolute/path/to/data/processed
